      <data key="d5">F013</data>
      <data key="d4">WHO-01</data>
      <data key="d6">Đường huyết cao kéo dài có thể gây tổn thương hệ thần kinh.</data>
    </edge>
    <edge source="SOURCE:WHO-01" target="Đái tháo đường" id="SUPPORTS:F014">
