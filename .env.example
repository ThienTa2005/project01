# Sao chép thành .env nếu dùng công cụ tự nạp dotenv, hoặc đặt trực tiếp bằng
# biến môi trường PowerShell/Render. Không commit khóa thật.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_OUTPUT_TOKENS=800

# Neo4j (tùy chọn)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
