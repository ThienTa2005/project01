// Runtime KB: dữ kiện có source_id, evidence và kb_file.
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_id_unique IF NOT EXISTS FOR (n:Source) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id:'Dinh dưỡng lành mạnh'}) SET n.name='Dinh dưỡng lành mạnh';
MERGE (n:Entity {id:'Duy trì cân nặng phù hợp'}) SET n.name='Duy trì cân nặng phù hợp';
MERGE (n:Entity {id:'Hạn chế đường và chất béo bão hòa'}) SET n.name='Hạn chế đường và chất béo bão hòa';
MERGE (n:Entity {id:'Không hút thuốc lá'}) SET n.name='Không hút thuốc lá';
MERGE (n:Entity {id:'Thừa cân hoặc béo phì'}) SET n.name='Thừa cân hoặc béo phì';
MERGE (n:Entity {id:'Tiền sử gia đình'}) SET n.name='Tiền sử gia đình';
MERGE (n:Entity {id:'Tiền sử đái tháo đường thai kỳ'}) SET n.name='Tiền sử đái tháo đường thai kỳ';
MERGE (n:Entity {id:'Vận động thể chất'}) SET n.name='Vận động thể chất';
MERGE (n:Entity {id:'Ít nhất 150 phút vận động vừa mỗi tuần'}) SET n.name='Ít nhất 150 phút vận động vừa mỗi tuần';
MERGE (n:Entity {id:'Ít vận động'}) SET n.name='Ít vận động';
MERGE (n:Entity {id:'Đái tháo đường típ 2'}) SET n.name='Đái tháo đường típ 2';
MERGE (s:Source {id:'CDC-02'}) SET s.title='CDC – Type 2 Diabetes', s.url='https://www.cdc.gov/diabetes/about/about-type-2-diabetes.html', s.publisher='US CDC', s.summary='Yếu tố nguy cơ và lối sống liên quan đái tháo đường típ 2.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2024-05-15', s.checked_at='2026-11-06';
MERGE (s:Source {id:'WHO-01'}) SET s.title='WHO – Diabetes', s.url='https://www.who.int/news-room/fact-sheets/detail/diabetes', s.publisher='World Health Organization', s.summary='Tổng quan về đái tháo đường, triệu chứng, biến chứng, phòng ngừa và điều trị.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2026-11-03', s.checked_at='2026-11-06';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Thừa cân hoặc béo phì'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F007'}]->(b) SET r.source_id='CDC-02', r.evidence='Thừa cân hoặc béo phì làm tăng nguy cơ mắc đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Ít vận động'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F008'}]->(b) SET r.source_id='CDC-02', r.evidence='Hoạt động thể chất không đủ là một yếu tố nguy cơ của đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Tiền sử gia đình'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F009'}]->(b) SET r.source_id='CDC-02', r.evidence='Có người thân bậc một mắc đái tháo đường típ 2 làm tăng nguy cơ mắc bệnh.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Tiền sử đái tháo đường thai kỳ'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F010'}]->(b) SET r.source_id='CDC-02', r.evidence='Tiền sử đái tháo đường thai kỳ có liên quan tăng nguy cơ mắc đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Vận động thể chất'}) MERGE (a)-[r:PREVENTION {fact_id:'F023'}]->(b) SET r.source_id='WHO-01', r.evidence='Hoạt động thể chất đều đặn có thể giúp phòng ngừa hoặc trì hoãn đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Dinh dưỡng lành mạnh'}) MERGE (a)-[r:PREVENTION {fact_id:'F024'}]->(b) SET r.source_id='WHO-01', r.evidence='Chế độ ăn lành mạnh giúp giảm nguy cơ mắc đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Duy trì cân nặng phù hợp'}) MERGE (a)-[r:PREVENTION {fact_id:'F025'}]->(b) SET r.source_id='WHO-01', r.evidence='Duy trì cân nặng phù hợp giúp phòng ngừa hoặc trì hoãn đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Không hút thuốc lá'}) MERGE (a)-[r:PREVENTION {fact_id:'F026'}]->(b) SET r.source_id='WHO-01', r.evidence='Tránh hút thuốc lá là một phần trong chiến lược phòng ngừa đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Ít nhất 150 phút vận động vừa mỗi tuần'}) MERGE (a)-[r:PREVENTION {fact_id:'F040'}]->(b) SET r.source_id='WHO-01', r.evidence='WHO khuyến nghị duy trì ít nhất 150 phút hoạt động thể chất mức độ vừa mỗi tuần để góp phần phòng ngừa đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Hạn chế đường và chất béo bão hòa'}) MERGE (a)-[r:PREVENTION {fact_id:'F041'}]->(b) SET r.source_id='WHO-01', r.evidence='Một chế độ ăn lành mạnh và hạn chế đường cùng chất béo bão hòa là một phần của phòng ngừa đái tháo đường típ 2.', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F007'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F008'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F009'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F010'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F023'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F024'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F025'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F026'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F040'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F041'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_risk_prevention.cypher';
