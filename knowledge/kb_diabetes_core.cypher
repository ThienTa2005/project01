// Runtime KB: dữ kiện có source_id, evidence và kb_file.
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_id_unique IF NOT EXISTS FOR (n:Source) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id:'Bệnh thận do đái tháo đường'}) SET n.name='Bệnh thận do đái tháo đường';
MERGE (n:Entity {id:'Hormone điều hòa đường huyết'}) SET n.name='Hormone điều hòa đường huyết';
MERGE (n:Entity {id:'Insulin'}) SET n.name='Insulin';
MERGE (n:Entity {id:'Kháng insulin'}) SET n.name='Kháng insulin';
MERGE (n:Entity {id:'Thận'}) SET n.name='Thận';
MERGE (n:Entity {id:'Tuyến tụy'}) SET n.name='Tuyến tụy';
MERGE (n:Entity {id:'Đái tháo đường'}) SET n.name='Đái tháo đường';
MERGE (n:Entity {id:'Đái tháo đường thai kỳ'}) SET n.name='Đái tháo đường thai kỳ';
MERGE (n:Entity {id:'Đái tháo đường típ 1'}) SET n.name='Đái tháo đường típ 1';
MERGE (n:Entity {id:'Đái tháo đường típ 2'}) SET n.name='Đái tháo đường típ 2';
MERGE (n:Entity {id:'Đường huyết tăng'}) SET n.name='Đường huyết tăng';
MERGE (s:Source {id:'CDC-02'}) SET s.title='CDC – Type 2 Diabetes', s.url='https://www.cdc.gov/diabetes/about/about-type-2-diabetes.html', s.publisher='US CDC', s.summary='Yếu tố nguy cơ và lối sống liên quan đái tháo đường típ 2.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2024-05-15', s.checked_at='2026-11-06';
MERGE (s:Source {id:'VIN-02'}) SET s.title='Vinmec – Các biến chứng mãn tính của bệnh tiểu đường', s.url='https://www.vinmec.com/vie/bai-viet/cac-bien-chung-man-tinh-cua-benh-tieu-duong-vi', s.publisher='Vinmec', s.summary='Biến chứng về võng mạc, thận, thần kinh và mạch máu.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2024-07-22', s.checked_at='2026-11-06';
MERGE (s:Source {id:'WHO-01'}) SET s.title='WHO – Diabetes', s.url='https://www.who.int/news-room/fact-sheets/detail/diabetes', s.publisher='World Health Organization', s.summary='Tổng quan về đái tháo đường, triệu chứng, biến chứng, phòng ngừa và điều trị.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2026-11-03', s.checked_at='2026-11-06';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đường huyết tăng'}) MERGE (a)-[r:RELATED_TO {fact_id:'F029'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường gắn với tình trạng glucose huyết tăng cao kéo dài.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Thận'}), (b:Entity {id:'Bệnh thận do đái tháo đường'}) MERGE (a)-[r:RELATED_TO {fact_id:'F031'}]->(b) SET r.source_id='VIN-02', r.evidence='Bệnh thận do đái tháo đường là một biến chứng vi mạch quan trọng.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường típ 1'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F034'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường típ 1 có đặc điểm thiếu insulin và cần điều trị insulin.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường típ 2'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F035'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường típ 2 liên quan việc cơ thể sử dụng insulin không hiệu quả.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường thai kỳ'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F036'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường thai kỳ là tăng đường huyết xuất hiện trong giai đoạn thai kỳ.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Insulin'}), (b:Entity {id:'Hormone điều hòa đường huyết'}) MERGE (a)-[r:IS_A {fact_id:'F037'}]->(b) SET r.source_id='WHO-01', r.evidence='Insulin là một hormone có vai trò điều hòa glucose trong máu.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Insulin'}), (b:Entity {id:'Tuyến tụy'}) MERGE (a)-[r:PRODUCED_BY {fact_id:'F038'}]->(b) SET r.source_id='CDC-02', r.evidence='Insulin là hormone được tuyến tụy sản xuất và giúp đưa đường trong máu vào tế bào để sử dụng làm năng lượng.', r.kb_file='kb_diabetes_core.cypher';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Kháng insulin'}) MERGE (a)-[r:RELATED_TO {fact_id:'F039'}]->(b) SET r.source_id='CDC-02', r.evidence='Trong đái tháo đường típ 2, tế bào không đáp ứng bình thường với insulin; tình trạng này được gọi là kháng insulin.', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F029'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'VIN-02'}), (e:Entity {id:'Thận'}) MERGE (s)-[r:SUPPORTS {fact_id:'F031'}]->(e) SET r.source_id='VIN-02', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F034'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F035'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F036'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Insulin'}) MERGE (s)-[r:SUPPORTS {fact_id:'F037'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Insulin'}) MERGE (s)-[r:SUPPORTS {fact_id:'F038'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_core.cypher';
MATCH (s:Source {id:'CDC-02'}), (e:Entity {id:'Đái tháo đường típ 2'}) MERGE (s)-[r:SUPPORTS {fact_id:'F039'}]->(e) SET r.source_id='CDC-02', r.kb_file='kb_diabetes_core.cypher';
