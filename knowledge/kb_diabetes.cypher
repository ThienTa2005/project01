MERGE (n:Entity {id:'Đường huyết tăng'}) SET n.name='Đường huyết tăng';
MERGE (s:Source {id:'WHO-01'}) SET s.title='WHO – Diabetes', s.url='https://www.who.int/news-room/fact-sheets/detail/diabetes', s.publisher='World Health Organization';
MERGE (s:Source {id:'NIDDK-01'}) SET s.title='NIDDK – Diabetes Tests & Diagnosis', s.url='https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis', s.publisher='NIDDK / NIH';
MERGE (s:Source {id:'NIDDK-02'}) SET s.title='NIDDK – The A1C Test & Diabetes', s.url='https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test', s.publisher='NIDDK / NIH';
MERGE (s:Source {id:'CDC-01'}) SET s.title='CDC – Symptoms of Diabetes', s.url='https://www.cdc.gov/diabetes/signs-symptoms/', s.publisher='US CDC';
MERGE (s:Source {id:'CDC-02'}) SET s.title='CDC – Type 2 Diabetes', s.url='https://www.cdc.gov/diabetes/about/about-type-2-diabetes.html', s.publisher='US CDC';
MERGE (s:Source {id:'VIN-01'}) SET s.title='Vinmec – Dấu hiệu sớm báo hiệu bệnh tiểu đường', s.url='https://www.vinmec.com/vie/bai-viet/dau-hieu-som-bao-hieu-benh-tieu-duong-vi', s.publisher='Vinmec';
MERGE (s:Source {id:'VIN-02'}) SET s.title='Vinmec – Các biến chứng mãn tính của bệnh tiểu đường', s.url='https://www.vinmec.com/vie/bai-viet/cac-bien-chung-man-tinh-cua-benh-tieu-duong-vi', s.publisher='Vinmec';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Khát nhiều'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F001'}]->(b) SET r.source_id='CDC-01', r.evidence='Khát nước nhiều là một trong các dấu hiệu thường gặp của bệnh đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Tiểu nhiều'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F002'}]->(b) SET r.source_id='CDC-01', r.evidence='Đi tiểu thường xuyên là dấu hiệu có thể gặp ở người mắc đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Mệt mỏi'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F003'}]->(b) SET r.source_id='CDC-01', r.evidence='Người mắc đái tháo đường có thể xuất hiện tình trạng mệt mỏi.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Nhìn mờ'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F004'}]->(b) SET r.source_id='CDC-01', r.evidence='Nhìn mờ có thể là triệu chứng của tăng đường huyết.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Sụt cân không chủ ý'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F005'}]->(b) SET r.source_id='WHO-01', r.evidence='Sụt cân không chủ ý có thể xuất hiện ở một số người mắc đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Vết thương chậm lành'}) MERGE (a)-[r:HAS_SYMPTOM {fact_id:'F006'}]->(b) SET r.source_id='VIN-01', r.evidence='Vết thương lâu lành là dấu hiệu cần lưu ý khi đánh giá bệnh đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Thừa cân hoặc béo phì'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F007'}]->(b) SET r.source_id='CDC-02', r.evidence='Thừa cân hoặc béo phì làm tăng nguy cơ mắc đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Ít vận động'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F008'}]->(b) SET r.source_id='CDC-02', r.evidence='Hoạt động thể chất không đủ là một yếu tố nguy cơ của đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Tiền sử gia đình'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F009'}]->(b) SET r.source_id='CDC-02', r.evidence='Có người thân bậc một mắc đái tháo đường típ 2 làm tăng nguy cơ mắc bệnh.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Tiền sử đái tháo đường thai kỳ'}) MERGE (a)-[r:HAS_RISK_FACTOR {fact_id:'F010'}]->(b) SET r.source_id='CDC-02', r.evidence='Tiền sử đái tháo đường thai kỳ có liên quan tăng nguy cơ mắc đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Bệnh thận do đái tháo đường'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F011'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường kéo dài có thể gây tổn thương thận.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Tổn thương võng mạc'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F012'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường có thể gây tổn thương mạch máu võng mạc và ảnh hưởng thị lực.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Tổn thương thần kinh'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F013'}]->(b) SET r.source_id='WHO-01', r.evidence='Đường huyết cao kéo dài có thể gây tổn thương hệ thần kinh.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Bệnh tim mạch'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F014'}]->(b) SET r.source_id='WHO-01', r.evidence='Người mắc đái tháo đường có nguy cơ biến cố tim mạch cao hơn.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Loét bàn chân'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F015'}]->(b) SET r.source_id='WHO-01', r.evidence='Tổn thương thần kinh và tuần hoàn kém có thể gây loét bàn chân ở người đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'HbA1c'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F016'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Xét nghiệm HbA1c có thể được sử dụng trong sàng lọc và chẩn đoán đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đường huyết lúc đói'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F017'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Xét nghiệm glucose huyết tương lúc đói được dùng để phát hiện đái tháo đường.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Nghiệm pháp dung nạp glucose'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F018'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Nghiệm pháp dung nạp glucose đường uống là một xét nghiệm chẩn đoán đái tháo đường.';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'Đường huyết trung bình khoảng 3 tháng'}) MERGE (a)-[r:REFLECTS {fact_id:'F019'}]->(b) SET r.source_id='NIDDK-02', r.evidence='HbA1c phản ánh mức glucose trung bình trong khoảng ba tháng trước thời điểm xét nghiệm.';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'5,7%–6,4%'}) MERGE (a)-[r:HAS_PREDIABETES_RANGE {fact_id:'F020'}]->(b) SET r.source_id='NIDDK-01', r.evidence='HbA1c từ 5,7% đến 6,4% nằm trong khoảng tiền đái tháo đường.';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'Từ 6,5%'}) MERGE (a)-[r:HAS_DIABETES_THRESHOLD {fact_id:'F021'}]->(b) SET r.source_id='NIDDK-01', r.evidence='HbA1c từ 6,5% có thể thuộc ngưỡng chẩn đoán đái tháo đường và thường cần xét nghiệm xác nhận.';
MATCH (a:Entity {id:'Đường huyết lúc đói'}), (b:Entity {id:'Từ 126 mg/dL'}) MERGE (a)-[r:HAS_DIABETES_THRESHOLD {fact_id:'F022'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Glucose huyết tương lúc đói từ 126 mg/dL là một ngưỡng chẩn đoán đái tháo đường; thông thường cần xác nhận.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Vận động thể chất'}) MERGE (a)-[r:PREVENTION {fact_id:'F023'}]->(b) SET r.source_id='WHO-01', r.evidence='Hoạt động thể chất đều đặn có thể giúp phòng ngừa hoặc trì hoãn đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Dinh dưỡng lành mạnh'}) MERGE (a)-[r:PREVENTION {fact_id:'F024'}]->(b) SET r.source_id='WHO-01', r.evidence='Chế độ ăn lành mạnh giúp giảm nguy cơ mắc đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Duy trì cân nặng phù hợp'}) MERGE (a)-[r:PREVENTION {fact_id:'F025'}]->(b) SET r.source_id='WHO-01', r.evidence='Duy trì cân nặng phù hợp giúp phòng ngừa hoặc trì hoãn đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Không hút thuốc lá'}) MERGE (a)-[r:PREVENTION {fact_id:'F026'}]->(b) SET r.source_id='WHO-01', r.evidence='Tránh hút thuốc lá là một phần trong chiến lược phòng ngừa đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Metformin'}) MERGE (a)-[r:CAN_BE_TREATED_WITH {fact_id:'F027'}]->(b) SET r.source_id='WHO-01', r.evidence='Metformin là một trong các nhóm thuốc được sử dụng điều trị đái tháo đường típ 2 theo chỉ định của bác sĩ.';
MATCH (a:Entity {id:'Đái tháo đường típ 1'}), (b:Entity {id:'Insulin'}) MERGE (a)-[r:REQUIRES {fact_id:'F028'}]->(b) SET r.source_id='WHO-01', r.evidence='Người mắc đái tháo đường típ 1 cần insulin để duy trì sự sống.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đường huyết tăng'}) MERGE (a)-[r:RELATED_TO {fact_id:'F029'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường gắn với tình trạng glucose huyết tăng cao kéo dài.';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Thận'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F030'}]->(b) SET r.source_id='WHO-01', r.evidence='Đường huyết cao lâu ngày có thể gây tổn thương thận.';
MATCH (a:Entity {id:'Thận'}), (b:Entity {id:'Bệnh thận do đái tháo đường'}) MERGE (a)-[r:RELATED_TO {fact_id:'F031'}]->(b) SET r.source_id='VIN-02', r.evidence='Bệnh thận do đái tháo đường là một biến chứng vi mạch quan trọng.';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Võng mạc'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F032'}]->(b) SET r.source_id='VIN-02', r.evidence='Đường huyết cao kéo dài có thể làm tổn thương võng mạc.';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Dây thần kinh'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F033'}]->(b) SET r.source_id='VIN-02', r.evidence='Đường huyết cao kéo dài có thể gây bệnh lý thần kinh.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường típ 1'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F034'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường típ 1 có đặc điểm thiếu insulin và cần điều trị insulin.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường típ 2'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F035'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường típ 2 liên quan việc cơ thể sử dụng insulin không hiệu quả.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đái tháo đường thai kỳ'}) MERGE (a)-[r:HAS_TYPE {fact_id:'F036'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường thai kỳ là tăng đường huyết xuất hiện trong giai đoạn thai kỳ.';
MATCH (a:Entity {id:'Insulin'}), (b:Entity {id:'Hormone điều hòa đường huyết'}) MERGE (a)-[r:IS_A {fact_id:'F037'}]->(b) SET r.source_id='WHO-01', r.evidence='Insulin là một hormone có vai trò điều hòa glucose trong máu.';
MATCH (a:Entity {id:'Insulin'}), (b:Entity {id:'Tuyến tụy'}) MERGE (a)-[r:PRODUCED_BY {fact_id:'F038'}]->(b) SET r.source_id='CDC-02', r.evidence='Insulin là hormone được tuyến tụy sản xuất và giúp đưa đường trong máu vào tế bào để sử dụng làm năng lượng.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Kháng insulin'}) MERGE (a)-[r:RELATED_TO {fact_id:'F039'}]->(b) SET r.source_id='CDC-02', r.evidence='Trong đái tháo đường típ 2, tế bào không đáp ứng bình thường với insulin; tình trạng này được gọi là kháng insulin.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Ít nhất 150 phút vận động vừa mỗi tuần'}) MERGE (a)-[r:PREVENTION {fact_id:'F040'}]->(b) SET r.source_id='WHO-01', r.evidence='WHO khuyến nghị duy trì ít nhất 150 phút hoạt động thể chất mức độ vừa mỗi tuần để góp phần phòng ngừa đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Hạn chế đường và chất béo bão hòa'}) MERGE (a)-[r:PREVENTION {fact_id:'F041'}]->(b) SET r.source_id='WHO-01', r.evidence='Một chế độ ăn lành mạnh và hạn chế đường cùng chất béo bão hòa là một phần của phòng ngừa đái tháo đường típ 2.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Lối sống lành mạnh'}) MERGE (a)-[r:CAN_BE_TREATED_WITH {fact_id:'F042'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường có thể được điều trị và quản lý bằng chế độ ăn, hoạt động thể chất và thuốc phù hợp.';
MATCH (a:Entity {id:'Đái tháo đường típ 2'}), (b:Entity {id:'Insulin hoặc thuốc hạ đường huyết'}) MERGE (a)-[r:CAN_BE_TREATED_WITH {fact_id:'F043'}]->(b) SET r.source_id='WHO-01', r.evidence='Một số người mắc đái tháo đường típ 2 cần insulin hoặc thuốc khác để kiểm soát đường huyết theo chỉ định chuyên môn.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Xét nghiệm máu tại cơ sở y tế'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F044'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Đái tháo đường và tiền đái tháo đường được chẩn đoán bằng xét nghiệm máu do nhân viên y tế đánh giá.';
MATCH (a:Entity {id:'Máy đo đường huyết tại nhà'}), (b:Entity {id:'Đái tháo đường'}) MERGE (a)-[r:NOT_SUFFICIENT_FOR_DIAGNOSIS {fact_id:'F045'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Máy đo đường huyết mua không cần đơn không thể tự xác lập chẩn đoán đái tháo đường; kết quả cần được cơ sở y tế đánh giá.';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Theo dõi biến chứng định kỳ'}) MERGE (a)-[r:REQUIRES {fact_id:'F046'}]->(b) SET r.source_id='WHO-01', r.evidence='Sàng lọc biến chứng thường xuyên và điều trị kịp thời giúp hạn chế hậu quả của đái tháo đường.';
