// Sinh từ knowledge/seed.json; dữ kiện có provenance.
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_id_unique IF NOT EXISTS FOR (n:Source) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id:'5,7%–6,4%'}) SET n.name='5,7%–6,4%';
MERGE (n:Entity {id:'Bệnh thận do đái tháo đường'}) SET n.name='Bệnh thận do đái tháo đường';
