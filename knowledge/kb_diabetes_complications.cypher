// Runtime KB: dữ kiện có source_id, evidence và kb_file.
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_id_unique IF NOT EXISTS FOR (n:Source) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id:'Bệnh thận do đái tháo đường'}) SET n.name='Bệnh thận do đái tháo đường';
MERGE (n:Entity {id:'Bệnh tim mạch'}) SET n.name='Bệnh tim mạch';
MERGE (n:Entity {id:'Dây thần kinh'}) SET n.name='Dây thần kinh';
MERGE (n:Entity {id:'Loét bàn chân'}) SET n.name='Loét bàn chân';
MERGE (n:Entity {id:'Thận'}) SET n.name='Thận';
MERGE (n:Entity {id:'Tổn thương thần kinh'}) SET n.name='Tổn thương thần kinh';
MERGE (n:Entity {id:'Tổn thương võng mạc'}) SET n.name='Tổn thương võng mạc';
MERGE (n:Entity {id:'Võng mạc'}) SET n.name='Võng mạc';
MERGE (n:Entity {id:'Đái tháo đường'}) SET n.name='Đái tháo đường';
MERGE (n:Entity {id:'Đường huyết tăng'}) SET n.name='Đường huyết tăng';
MERGE (s:Source {id:'VIN-02'}) SET s.title='Vinmec – Các biến chứng mãn tính của bệnh tiểu đường', s.url='https://www.vinmec.com/vie/bai-viet/cac-bien-chung-man-tinh-cua-benh-tieu-duong-vi', s.publisher='Vinmec', s.summary='Biến chứng về võng mạc, thận, thần kinh và mạch máu.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2024-07-22', s.checked_at='2026-11-06';
MERGE (s:Source {id:'WHO-01'}) SET s.title='WHO – Diabetes', s.url='https://www.who.int/news-room/fact-sheets/detail/diabetes', s.publisher='World Health Organization', s.summary='Tổng quan về đái tháo đường, triệu chứng, biến chứng, phòng ngừa và điều trị.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.published_at='2026-11-03', s.checked_at='2026-11-06';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Bệnh thận do đái tháo đường'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F011'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường kéo dài có thể gây tổn thương thận.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Tổn thương võng mạc'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F012'}]->(b) SET r.source_id='WHO-01', r.evidence='Đái tháo đường có thể gây tổn thương mạch máu võng mạc và ảnh hưởng thị lực.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Tổn thương thần kinh'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F013'}]->(b) SET r.source_id='WHO-01', r.evidence='Đường huyết cao kéo dài có thể gây tổn thương hệ thần kinh.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Bệnh tim mạch'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F014'}]->(b) SET r.source_id='WHO-01', r.evidence='Người mắc đái tháo đường có nguy cơ biến cố tim mạch cao hơn.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Loét bàn chân'}) MERGE (a)-[r:HAS_COMPLICATION {fact_id:'F015'}]->(b) SET r.source_id='WHO-01', r.evidence='Tổn thương thần kinh và tuần hoàn kém có thể gây loét bàn chân ở người đái tháo đường.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Thận'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F030'}]->(b) SET r.source_id='WHO-01', r.evidence='Đường huyết cao lâu ngày có thể gây tổn thương thận.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Võng mạc'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F032'}]->(b) SET r.source_id='VIN-02', r.evidence='Đường huyết cao kéo dài có thể làm tổn thương võng mạc.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (a:Entity {id:'Đường huyết tăng'}), (b:Entity {id:'Dây thần kinh'}) MERGE (a)-[r:CAN_DAMAGE {fact_id:'F033'}]->(b) SET r.source_id='VIN-02', r.evidence='Đường huyết cao kéo dài có thể gây bệnh lý thần kinh.', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F011'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F012'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F013'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F014'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F015'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'WHO-01'}), (e:Entity {id:'Đường huyết tăng'}) MERGE (s)-[r:SUPPORTS {fact_id:'F030'}]->(e) SET r.source_id='WHO-01', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'VIN-02'}), (e:Entity {id:'Đường huyết tăng'}) MERGE (s)-[r:SUPPORTS {fact_id:'F032'}]->(e) SET r.source_id='VIN-02', r.kb_file='kb_diabetes_complications.cypher';
MATCH (s:Source {id:'VIN-02'}), (e:Entity {id:'Đường huyết tăng'}) MERGE (s)-[r:SUPPORTS {fact_id:'F033'}]->(e) SET r.source_id='VIN-02', r.kb_file='kb_diabetes_complications.cypher';
