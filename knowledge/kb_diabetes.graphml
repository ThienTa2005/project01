      <data key="d5">F035</data>
      <data key="d4">WHO-01</data>
      <data key="d6">Đái tháo đường típ 2 liên quan việc cơ thể sử dụng insulin không hiệu quả.</data>
    </edge>
    <edge source="SOURCE:WHO-01" target="Đái tháo đường" id="SUPPORTS:F036">
      <data key="d3">SUPPORTS</data>
      <data key="d5">F036</data>
      <data key="d4">WHO-01</data>
      <data key="d6">Đái tháo đường thai kỳ là tăng đường huyết xuất hiện trong giai đoạn thai kỳ.</data>
