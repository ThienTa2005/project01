// Runtime KB: dữ kiện có source_id, evidence và kb_file.
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT source_id_unique IF NOT EXISTS FOR (n:Source) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id:'5,7%–6,4%'}) SET n.name='5,7%–6,4%';
MERGE (n:Entity {id:'HbA1c'}) SET n.name='HbA1c';
MERGE (n:Entity {id:'Máy đo đường huyết tại nhà'}) SET n.name='Máy đo đường huyết tại nhà';
MERGE (n:Entity {id:'Nghiệm pháp dung nạp glucose'}) SET n.name='Nghiệm pháp dung nạp glucose';
MERGE (n:Entity {id:'Từ 126 mg/dL'}) SET n.name='Từ 126 mg/dL';
MERGE (n:Entity {id:'Từ 6,5%'}) SET n.name='Từ 6,5%';
MERGE (n:Entity {id:'Xét nghiệm máu tại cơ sở y tế'}) SET n.name='Xét nghiệm máu tại cơ sở y tế';
MERGE (n:Entity {id:'Đái tháo đường'}) SET n.name='Đái tháo đường';
MERGE (n:Entity {id:'Đường huyết lúc đói'}) SET n.name='Đường huyết lúc đói';
MERGE (n:Entity {id:'Đường huyết trung bình khoảng 3 tháng'}) SET n.name='Đường huyết trung bình khoảng 3 tháng';
MERGE (s:Source {id:'NIDDK-01'}) SET s.title='NIDDK – Diabetes Tests & Diagnosis', s.url='https://www.niddk.nih.gov/health-information/diabetes/overview/tests-diagnosis', s.publisher='NIDDK / NIH', s.summary='Ngưỡng HbA1c và glucose, nguyên tắc xác nhận xét nghiệm chẩn đoán.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.checked_at='2026-11-06';
MERGE (s:Source {id:'NIDDK-02'}) SET s.title='NIDDK – The A1C Test & Diabetes', s.url='https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test', s.publisher='NIDDK / NIH', s.summary='HbA1c phản ánh mức glucose trung bình xấp xỉ ba tháng.', s.kind='curated', s.curation='Tóm lược thủ công từ nguồn công khai; không phải dữ liệu huấn luyện ML.', s.checked_at='2026-11-06';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'HbA1c'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F016'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Xét nghiệm HbA1c có thể được sử dụng trong sàng lọc và chẩn đoán đái tháo đường.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Đường huyết lúc đói'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F017'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Xét nghiệm glucose huyết tương lúc đói được dùng để phát hiện đái tháo đường.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Nghiệm pháp dung nạp glucose'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F018'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Nghiệm pháp dung nạp glucose đường uống là một xét nghiệm chẩn đoán đái tháo đường.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'Đường huyết trung bình khoảng 3 tháng'}) MERGE (a)-[r:REFLECTS {fact_id:'F019'}]->(b) SET r.source_id='NIDDK-02', r.evidence='HbA1c phản ánh mức glucose trung bình trong khoảng ba tháng trước thời điểm xét nghiệm.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'5,7%–6,4%'}) MERGE (a)-[r:HAS_PREDIABETES_RANGE {fact_id:'F020'}]->(b) SET r.source_id='NIDDK-01', r.evidence='HbA1c từ 5,7% đến 6,4% nằm trong khoảng tiền đái tháo đường.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'HbA1c'}), (b:Entity {id:'Từ 6,5%'}) MERGE (a)-[r:HAS_DIABETES_THRESHOLD {fact_id:'F021'}]->(b) SET r.source_id='NIDDK-01', r.evidence='HbA1c từ 6,5% có thể thuộc ngưỡng chẩn đoán đái tháo đường và thường cần xét nghiệm xác nhận.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'Đường huyết lúc đói'}), (b:Entity {id:'Từ 126 mg/dL'}) MERGE (a)-[r:HAS_DIABETES_THRESHOLD {fact_id:'F022'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Glucose huyết tương lúc đói từ 126 mg/dL là một ngưỡng chẩn đoán đái tháo đường; thông thường cần xác nhận.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'Đái tháo đường'}), (b:Entity {id:'Xét nghiệm máu tại cơ sở y tế'}) MERGE (a)-[r:ASSESSED_WITH {fact_id:'F044'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Đái tháo đường và tiền đái tháo đường được chẩn đoán bằng xét nghiệm máu do nhân viên y tế đánh giá.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (a:Entity {id:'Máy đo đường huyết tại nhà'}), (b:Entity {id:'Đái tháo đường'}) MERGE (a)-[r:NOT_SUFFICIENT_FOR_DIAGNOSIS {fact_id:'F045'}]->(b) SET r.source_id='NIDDK-01', r.evidence='Máy đo đường huyết mua không cần đơn không thể tự xác lập chẩn đoán đái tháo đường; kết quả cần được cơ sở y tế đánh giá.', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F016'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F017'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F018'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-02'}), (e:Entity {id:'HbA1c'}) MERGE (s)-[r:SUPPORTS {fact_id:'F019'}]->(e) SET r.source_id='NIDDK-02', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'HbA1c'}) MERGE (s)-[r:SUPPORTS {fact_id:'F020'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'HbA1c'}) MERGE (s)-[r:SUPPORTS {fact_id:'F021'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Đường huyết lúc đói'}) MERGE (s)-[r:SUPPORTS {fact_id:'F022'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Đái tháo đường'}) MERGE (s)-[r:SUPPORTS {fact_id:'F044'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
MATCH (s:Source {id:'NIDDK-01'}), (e:Entity {id:'Máy đo đường huyết tại nhà'}) MERGE (s)-[r:SUPPORTS {fact_id:'F045'}]->(e) SET r.source_id='NIDDK-01', r.kb_file='kb_diabetes_diagnosis.cypher';
