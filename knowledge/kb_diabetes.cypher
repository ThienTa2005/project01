MERGE (n:Entity {id:'Từ 126 mg/dL'}) SET n.name='Từ 126 mg/dL';
MERGE (n:Entity {id:'Từ 6,5%'}) SET n.name='Từ 6,5%';
MERGE (n:Entity {id:'Võng mạc'}) SET n.name='Võng mạc';
MERGE (n:Entity {id:'Vận động thể chất'}) SET n.name='Vận động thể chất';
MERGE (n:Entity {id:'Vết thương chậm lành'}) SET n.name='Vết thương chậm lành';
