      <data key="d5">F034</data>
      <data key="d4">WHO-01</data>
      <data key="d6">Đái tháo đường típ 1 có đặc điểm thiếu insulin và cần điều trị insulin.</data>
    </edge>
    <edge source="SOURCE:WHO-01" target="Đái tháo đường" id="SUPPORTS:F035">
